# Use exact versions in package.json
save-exact=true

# Ensure package-lock.json is always created
package-lock=true

# Disable funding messages
fund=false

# Disable audit on install (can be run separately with npm audit)
audit=false

# Use npm's default registry
registry=https://registry.npmjs.org/

# Engine strict mode (set false to allow install on older Node, e.g. for mermaid-cli)
engine-strict=false

# Prefer offline mode when possible
prefer-offline=false

# Log level
loglevel=warn
